<?xml version="1.0" encoding="UTF-8"?>
<!--
  Navigation adapted from WiX 3.11.2 WixUI_InstallDir.wxs.
  Copyright (c) .NET Foundation and contributors. All rights reserved.
  This file is licensed under the Microsoft Reciprocal License; see WiX-LICENSE.txt.
  nngGram changes: no license click-through; explicit shortcut options; data-preservation note;
  launch only from the user's checked Finish page. Initial directory configuration uses the
  application's CREATE_NEW helper; existing account configuration is never overwritten.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <UI Id="NngGramUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Microsoft YaHei UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Microsoft YaHei UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Microsoft YaHei UI" Size="10" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="InstallDir" />
      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath" Order="3">1</Publish>
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Order="1">WIXUI_EXITDIALOGOPTIONALCHECKBOX = "1" AND NOT Installed AND UILevel &gt;= 4</Publish>
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999">1</Publish>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg">NOT Installed</Publish>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">Installed AND PATCH</Publish>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath" Order="2">NOT WIXUI_DONTVALIDATEPATH</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutOptionsDlg" Order="4">NNGGRAM_EXISTING_CONFIG AND (WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1")</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Property="WIXUI_INSTALLDIR" Value="DATAFOLDER" Order="5">NOT NNGGRAM_EXISTING_CONFIG AND (WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1")</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="DataDirectoryDlg" Order="6">NOT NNGGRAM_EXISTING_CONFIG AND (WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1")</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutOptionsDlg" Order="1">NOT Installed</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2">Installed AND NOT PATCH</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2">Installed AND PATCH</Publish>
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>
      <Dialog Id="DataDirectoryDlg" Width="370" Height="270" Title="nngGram 安装">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\WixUI_Font_Bigger}选择聊天和文件数据目录" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="330" Height="48" Text="账号、聊天数据库、媒体缓存和默认保存的文件统一放在此目录。请选择程序安装目录之外的位置。" />
        <Control Id="DataPath" Type="PathEdit" X="20" Y="110" Width="265" Height="18" Property="DATAFOLDER" />
        <Control Id="Browse" Type="PushButton" X="292" Y="110" Width="58" Height="18" Text="浏览...">
          <Publish Property="_BrowseProperty" Value="DATAFOLDER" Order="1">1</Publish>
          <Publish Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>
        </Control>
        <Control Id="DataNote" Type="Text" X="20" Y="150" Width="330" Height="60" Text="升级和卸载保留此目录及已有配置。本页只为首次安装设置默认路径，不会移动现有账号。少量启动配置和界面偏好保留在当前用户的 AppData 中。" />
        <Control Id="Line" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="上一步">
          <Publish Property="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" Order="1">1</Publish>
          <Publish Event="NewDialog" Value="InstallDirDlg" Order="2">1</Publish>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="下一步">
          <Publish Event="SetTargetPath" Value="DATAFOLDER" Order="1">1</Publish>
          <Publish Event="DoAction" Value="WixUIValidatePath" Order="2">NOT WIXUI_DONTVALIDATEPATH</Publish>
          <Publish Event="SpawnDialog" Value="InvalidDirDlg" Order="3"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>
          <Publish Event="NewDialog" Value="ShortcutOptionsDlg" Order="4">WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1"</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
      <Dialog Id="ShortcutOptionsDlg" Width="370" Height="270" Title="nngGram 安装">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\WixUI_Font_Bigger}选择快捷方式" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="330" Height="30" Text="将 nngGram 安装到所选目录。使用本程序无需另装 JVM。" />
        <Control Id="StartMenu" Type="CheckBox" X="20" Y="95" Width="330" Height="18" Property="CREATE_START_MENU" CheckBoxValue="1" Text="创建开始菜单快捷方式" />
        <Control Id="Desktop" Type="CheckBox" X="20" Y="125" Width="330" Height="18" Property="CREATE_DESKTOP" CheckBoxValue="1" Text="创建桌面快捷方式" />
        <Control Id="DataNote" Type="Text" X="20" Y="160" Width="330" Height="45" Text="升级和卸载会保留账号、数据库、已下载媒体与本地设置。安装过程不会登录账号或发送消息。" />
        <Control Id="Line" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="上一步">
          <Publish Event="NewDialog" Value="InstallDirDlg" Order="1">NNGGRAM_EXISTING_CONFIG</Publish>
          <Publish Event="NewDialog" Value="DataDirectoryDlg" Order="2">NOT NNGGRAM_EXISTING_CONFIG</Publish>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="下一步">
          <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
    </UI>
    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
